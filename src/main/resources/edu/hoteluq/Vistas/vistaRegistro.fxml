<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.hoteluq.controlador.ControladorRegistro"
      alignment="CENTER"
      spacing="10"
      prefHeight="550.0"
      prefWidth="600.0">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="HotelUQ"/>

    <Label text="Registro de cliente"/>

    <Label text="Documento"/>
    <TextField fx:id="campoDocumento" promptText="Ingrese su identificación"/>

    <Label text="Nombre completo"/>
    <TextField fx:id="campoNombre" promptText="Ingrese su nombre completo"/>

    <Label text="Correo electrónico"/>
    <TextField fx:id="campoCorreo" promptText="Ingrese su correo electrónico"/>

    <Label text="Teléfono"/>
    <TextField fx:id="campoTelefono" promptText="Ingrese su teléfono"/>

    <Label text="Contraseña"/>
    <PasswordField fx:id="campoContrasenia" promptText="Ingrese su contraseña"/>

    <Button text="Registrarse" onAction="#registrarCliente"/>

    <Button text="Volver al inicio"
            onAction="#volverInicio"/>

</VBox>