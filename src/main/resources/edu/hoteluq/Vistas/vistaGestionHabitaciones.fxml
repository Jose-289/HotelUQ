<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionHabitaciones">

    <padding>
        <Insets bottom="25" left="25" right="25" top="25" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A365D;" text="Gestión de Habitaciones (Factory Method)" />

    <!-- TABLA DE HABITACIONES -->
    <TableView fx:id="tablaHabitaciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnaNumero" prefWidth="100.0" text="Número" />
            <TableColumn fx:id="columnaTipo" prefWidth="150.0" text="Tipo" />
            <TableColumn fx:id="columnaCapacidad" prefWidth="120.0" text="Capacidad" />
            <TableColumn fx:id="columnaTarifa" prefWidth="150.0" text="Tarifa Noche" />
            <TableColumn fx:id="columnaEstado" prefWidth="155.0" text="Estado" />
        </columns>
    </TableView>

    <!-- FORMULARIO DE REGISTRO RÁPIDO -->
    <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <TextField fx:id="campoNumero" promptText="N° Habitación" prefWidth="120.0" />
        <ComboBox fx:id="comboFabricas" promptText="Seleccionar Tipo (Habitación)" prefWidth="180.0" />
        <ComboBox fx:id="comboEstado" promptText="Estado inicial" prefWidth="140.0" />
        <Button onAction="#registrarHabitacion" style="-fx-background-color: #319795; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Registrar Habitación" />
        <Button onAction="#eliminarHabitacion" style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar Seleccionada" />
    </HBox>

    <!-- PANEL DE CAMBIO DE ESTADO -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 8;">
        <Label text="Cambiar estado de selección:" style="-fx-font-weight: bold; -fx-text-fill: #2D3748;" />
        <ComboBox fx:id="comboNuevoEstado" promptText="Nuevo estado" prefWidth="150.0" />
        <Button text="Actualizar Estado" onAction="#cambiarEstadoHabitacion" style="-fx-background-color: #2B6CB0; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>

    <!-- BOTÓN VOLVER -->
    <HBox alignment="CENTER_LEFT">
        <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-cursor: hand;" text="Volver al Menú" />
    </HBox>

</VBox>

