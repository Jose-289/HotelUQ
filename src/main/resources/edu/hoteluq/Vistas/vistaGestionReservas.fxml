<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionReservas">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1A365D; -fx-padding: 15 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="HotelUQ - Gestión de Reservas (Builder)" />
        </HBox>
    </top>

    <!-- CENTRO: FORMULARIO DE CREACIÓN + TABLA -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>

            <!-- PANEL NUEVA RESERVA -->
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Registrar Nueva Reserva" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <ComboBox fx:id="comboClientes" prefWidth="200.0" promptText="Seleccionar Cliente" />
                    <ComboBox fx:id="comboHabitaciones" prefWidth="210.0" promptText="Seleccionar Habitación" />
                    <DatePicker fx:id="dateEntrada" prefWidth="145.0" promptText="Fecha Entrada" />
                    <DatePicker fx:id="dateSalida" prefWidth="145.0" promptText="Fecha Salida" />
                    <Button onAction="#crearReserva" style="-fx-background-color: #DD6B20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 15;" text="Reservar y Cobrar" />
                </HBox>
            </VBox>

            <!-- TABLA DE RESERVAS -->
            <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="110.0" text="Código" />
                    <TableColumn fx:id="colCliente" prefWidth="190.0" text="Cliente" />
                    <TableColumn fx:id="colHabitacion" prefWidth="150.0" text="Habitación" />
                    <TableColumn fx:id="colEntrada" prefWidth="120.0" text="Entrada" />
                    <TableColumn fx:id="colSalida" prefWidth="120.0" text="Salida" />
                    <TableColumn fx:id="colTotal" prefWidth="130.0" text="Valor Total" />
                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                </columns>
            </TableView>

            <!-- ACCIONES INFERIORES -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="← Volver al Menú" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#cancelarReservaSeleccionada" style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="Cancelar Reserva (Reembolso 100%)" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
