<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.hoteluq.controlador.ControladorGestionClientes">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Gestión de clientes"/>

    <TableView fx:id="tablaClientes">
        <columns>
            <TableColumn fx:id="columnaDocumento" text="Documento"/>
            <TableColumn fx:id="columnaNombre" text="Nombre"/>
            <TableColumn fx:id="columnaCorreo" text="Correo"/>
            <TableColumn fx:id="columnaTelefono" text="Teléfono"/>
        </columns>
    </TableView>

    <VBox spacing="10.0">
        <Button text="Agregar cliente"/>
        <Button text="Eliminar cliente"/>
        <Button text="Modificar cliente"/>
        <Button text="Volver"/>
    </VBox>

</VBox>