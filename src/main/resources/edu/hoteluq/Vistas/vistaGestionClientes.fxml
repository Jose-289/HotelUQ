<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionClientes">

    <!-- BARRA SUPERIOR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1A365D; -fx-padding: 15 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="HotelUQ - Gestión de Clientes" />
        </HBox>
    </top>

    <!-- CENTRO: TABLA -->
    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Lista de Clientes Registrados" />

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6px;">
                <columns>
                    <TableColumn fx:id="columnaDocumento" prefWidth="180.0" text="Documento" />
                    <TableColumn fx:id="columnaNombre" prefWidth="250.0" text="Nombre" />
                    <TableColumn fx:id="columnaCorreo" prefWidth="250.0" text="Correo" />
                    <TableColumn fx:id="columnaTelefono" prefWidth="195.0" text="Teléfono" />
                </columns>
            </TableView>

            <!-- ACCIONES / BOTONES INFERIORES -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="← Volver al Menú" />
            </HBox>
        </VBox>
    </center>

</BorderPane>