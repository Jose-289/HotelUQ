<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionPromociones">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1A365D; -fx-padding: 15 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="HotelUQ - Gestión de Promociones (Strategy)" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>

            <!-- FORMULARIO NUEVA PROMOCIÓN -->
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Crear Nueva Promoción" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <TextField fx:id="campoCodigo" prefWidth="100.0" promptText="Código" />
                    <TextField fx:id="campoDescripcion" prefWidth="210.0" promptText="Descripción" />
                    <ComboBox fx:id="comboTipoEstrategia" prefWidth="160.0" promptText="Tipo Descuento" />
                    <TextField fx:id="campoValorDescuento" prefWidth="110.0" promptText="Valor (% o $)" />
                    <TextField fx:id="campoCondicionMinima" prefWidth="120.0" promptText="Mín. noches/$" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <DatePicker fx:id="dateInicio" prefWidth="150.0" promptText="Fecha Inicio" />
                    <DatePicker fx:id="dateFin" prefWidth="150.0" promptText="Fecha Fin" />
                    <Button onAction="#registrarPromocion" style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 7 15;" text="Guardar Promoción" />
                </HBox>
            </VBox>

            <!-- TABLA DE PROMOCIONES -->
            <TableView fx:id="tablaPromociones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                    <TableColumn fx:id="colDescripcion" prefWidth="240.0" text="Descripción" />
                    <TableColumn fx:id="colEstrategia" prefWidth="250.0" text="Estrategia Aplicada" />
                    <TableColumn fx:id="colVigencia" prefWidth="190.0" text="Vigencia" />
                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="← Volver al Menú" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button onAction="#eliminarPromocion" style="-fx-background-color: #E53E3E; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="Eliminar Seleccionada" />
            </HBox>
        </VBox>
    </center>

</BorderPane>