<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionReportes">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1A365D; -fx-padding: 15 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="HotelUQ - Gestión de Reportes" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>

            <!-- TARJETAS KPI EN TIEMPO REAL -->
            <HBox spacing="15.0">
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #718096; -fx-font-size: 12px;" text="Habitaciones (Disp / Total)" />
                    <Label fx:id="lblKpiHabitaciones" style="-fx-text-fill: #1A365D; -fx-font-size: 20px; -fx-font-weight: bold;" text="0 / 0" />
                </VBox>
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #718096; -fx-font-size: 12px;" text="Clientes Registrados" />
                    <Label fx:id="lblKpiClientes" style="-fx-text-fill: #2B6CB0; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                </VBox>
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #718096; -fx-font-size: 12px;" text="Reservas Confirmadas" />
                    <Label fx:id="lblKpiReservas" style="-fx-text-fill: #DD6B20; -fx-font-size: 20px; -fx-font-weight: bold;" text="0" />
                </VBox>
                <VBox spacing="4.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #718096; -fx-font-size: 12px;" text="Ingresos Totales" />
                    <Label fx:id="lblKpiIngresos" style="-fx-text-fill: #38A169; -fx-font-size: 20px; -fx-font-weight: bold;" text="\$0.0" />
                </VBox>
            </HBox>

            <!-- BARRA DE EXPORTACIÓN -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Formato de Exportación:" />
                <ComboBox fx:id="comboFormatos" prefWidth="220.0" promptText="Seleccionar formato" />
                <Button onAction="#exportarReporte" style="-fx-background-color: #319795; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 18;" text="Generar y Guardar Reporte" />
            </HBox>

            <!-- VISTA PREVIA DE RESERVAS -->
            <TableView fx:id="tablaVistaPrevia" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="120.0" text="Código" />
                    <TableColumn fx:id="colCliente" prefWidth="230.0" text="Cliente" />
                    <TableColumn fx:id="colHabitacion" prefWidth="180.0" text="Habitación" />
                    <TableColumn fx:id="colTotal" prefWidth="180.0" text="Valor Total" />
                    <TableColumn fx:id="colEstado" prefWidth="180.0" text="Estado" />
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT">
                <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="← Volver al Menú" />
            </HBox>
        </VBox>
    </center>

</BorderPane>