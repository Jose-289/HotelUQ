<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.hoteluq.controlador.ControladorGestionServicios">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1A365D; -fx-padding: 15 25;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="HotelUQ - Gestión de Servicios Adicionales (Decorator)" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Servicios Ofrecidos por el Hotel" />

            <TableView fx:id="tablaServicios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="100.0" text="Código" />
                    <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                    <TableColumn fx:id="colDescripcion" prefWidth="300.0" text="Descripción" />
                    <TableColumn fx:id="colPrecio" prefWidth="150.0" text="Precio" />
                    <TableColumn fx:id="colDisponible" prefWidth="150.0" text="Disponible" />
                </columns>
            </TableView>

            <!-- FORMULARIO NUEVO SERVICIO -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
                <TextField fx:id="campoId" promptText="Código" prefWidth="90.0" />
                <TextField fx:id="campoNombre" promptText="Nombre servicio" prefWidth="160.0" />
                <TextField fx:id="campoDescripcion" promptText="Descripción" prefWidth="220.0" />
                <TextField fx:id="campoPrecio" promptText="Precio" prefWidth="110.0" />
                <CheckBox fx:id="checkDisponible" text="Disponible" selected="true" />
                <Button onAction="#registrarServicio" style="-fx-background-color: #805AD5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Registrar Servicio" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button onAction="#volverMenu" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="← Volver al Menú" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
